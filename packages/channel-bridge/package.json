{
  "name": "@codetgh/channel-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --minify \"--banner:js=import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --metafile=dist/meta.json --outfile=../plugin/dist/channel.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@codetgh/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
