# Copy to deploy/.env and fill in. Never commit the real file.
CODETGH_PUBLIC_URL=https://codetgh.example.com
# openssl rand -base64 32
CODETGH_SECRET=
POSTGRES_PASSWORD=
# Optional sign-in providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional email (magic links, invitations), any SMTP provider: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=CodeTgh <no-reply@example.com>
# Optional: separate seed for the audit signing key (32 random bytes, base64); derived from CODETGH_SECRET when empty
CODETGH_AUDIT_KEY=
# Optional: Slack bridge (a Slack app with chat:write and commands; events to <hub>/bridges/slack/events,
# the /codetgh-link slash command to <hub>/bridges/slack/commands)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional: SSO with the organization's OpenID provider (redirect URI: <hub>/api/auth/callback/sso,
# back-channel logout URI: <hub>/sso/backchannel-logout)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
