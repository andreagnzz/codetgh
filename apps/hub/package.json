{
  "name": "@codetgh/hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server/main.js",
    "bootstrap": "tsx src/bootstrap.ts",
    "typecheck": "tsc -p .",
    "build": "esbuild src/main.ts src/bootstrap.ts --bundle --platform=node --format=esm --target=node22 --external:@electric-sql/pglite --external:pg-native \"--banner:js=import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --metafile=dist/meta.json --outdir=dist/server"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@codetgh/guard": "workspace:*",
    "@codetgh/shared": "workspace:*",
    "@electric-sql/pglite": "0.5.9",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "htmx-ext-sse": "2.2.4",
    "htmx.org": "2.0.11",
    "jose": "6.2.12",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "oauth4webapi": "3.8.8",
    "ulid": "3.0.2"
  }
}
